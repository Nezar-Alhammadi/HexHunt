{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexHunt Bench",
  "version": "0.1.0",
  "identifier": "com.hexhunt.bench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "HexHunt Bench",
      "width": 1200,
      "height": 760,
      "minWidth": 900,
      "minHeight": 600,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "HexHunt Bench workspace"
  }
}

